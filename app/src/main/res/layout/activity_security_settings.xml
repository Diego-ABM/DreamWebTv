<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:background="#1A1A1A"
    android:padding="48dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Seguridad y privacidad"
        android:textColor="#FFFFFF"
        android:textSize="36sp"
        android:textStyle="bold"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Excepciones TLS por dominio"
        android:textColor="#AAAAAA"
        android:textSize="18sp"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:id="@+id/emptyText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="No hay excepciones TLS guardadas"
        android:textColor="#888888"
        android:textSize="16sp"
        android:visibility="gone"
        android:layout_marginBottom="16dp"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/exceptionsRecyclerView"
        android:layout_width="800dp"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="vertical"/>

    <Button
        android:id="@+id/clearAllButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Borrar todas las excepciones TLS"
        android:layout_marginTop="16dp"
        android:focusable="true"
        android:backgroundTint="#B71C1C"
        android:textColor="#FFFFFF"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="AdBlock: dominios exceptuados"
        android:textColor="#AAAAAA"
        android:textSize="18sp"
        android:layout_marginTop="32dp"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:id="@+id/emptyAdBlockText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="No hay dominios exceptuados de AdBlock"
        android:textColor="#888888"
        android:textSize="16sp"
        android:visibility="gone"
        android:layout_marginBottom="16dp"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/adBlockWhitelistRecyclerView"
        android:layout_width="800dp"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="vertical"/>

    <Button
        android:id="@+id/clearAdBlockButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Quitar todos los dominios exceptuados"
        android:layout_marginTop="16dp"
        android:focusable="true"
        android:backgroundTint="#B71C1C"
        android:textColor="#FFFFFF"/>

</LinearLayout>
