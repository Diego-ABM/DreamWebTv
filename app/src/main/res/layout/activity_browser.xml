<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <FrameLayout
        android:id="@+id/webViewContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <FrameLayout
        android:id="@+id/fullscreenContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:visibility="gone" />

    <ImageButton
        android:id="@+id/favoriteButton"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="top|end"
        android:layout_margin="16dp"
        android:src="@android:drawable/btn_star_big_off"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:focusable="true"
        android:contentDescription="Añadir a favoritos" />

    <ImageButton
        android:id="@+id/uaToggleButton"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="80dp"
        android:layout_marginEnd="16dp"
        android:src="@android:drawable/ic_menu_view"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:focusable="true"
        android:contentDescription="Cambiar User Agent" />

    <ImageButton
        android:id="@+id/adBlockToggleButton"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="144dp"
        android:layout_marginEnd="16dp"
        android:src="@android:drawable/ic_menu_close_clear_cancel"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:focusable="true"
        android:contentDescription="Permitir ads en este sitio" />

    <TextView
        android:id="@+id/adBlockCounterText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_margin="12dp"
        android:padding="6dp"
        android:background="#88000000"
        android:textColor="#00FF00"
        android:textSize="14sp"
        android:translationZ="40dp"
        android:visibility="gone" />

    <!-- Indicador de hallazgos (evolución del externalPlayerButton):
         badge no intrusivo con nº de videos; abre el panel bajo demanda.
         translationZ bajo el cursor virtual (50dp). -->
    <Button
        android:id="@+id/videoIndicatorButton"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:layout_gravity="center|end"
        android:layout_marginEnd="16dp"
        android:background="@android:drawable/toast_frame"
        android:padding="8dp"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:visibility="gone"
        android:focusable="true"
        android:translationZ="25dp"
        android:contentDescription="@string/video_indicator_desc" />

    <!-- Panel de hallazgos: overlay lateral derecho ~35% ancho.
         translationZ por encima del webView Y del cursor virtual (50dp). -->
    <FrameLayout
        android:id="@+id/findingsPanel"
        android:layout_width="640dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:background="#E6111111"
        android:visibility="gone"
        android:translationZ="60dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/findings_panel_title"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/findingsRecycler"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:descendantFocusability="afterDescendants" />
        </LinearLayout>
    </FrameLayout>

    <!-- Hint "ver en pantalla completa": pill sobre el video que suena
         (paridad BrowseHere). Aparece cuando el detector reporta playstate
         playing y existe al menos un hallazgo lanzable. Bajo el cursor
         virtual (50dp); encima del webView. -->
    <Button
        android:id="@+id/fullscreenHintButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="72dp"
        android:background="@android:drawable/toast_frame"
        android:paddingLeft="20dp"
        android:paddingTop="10dp"
        android:paddingRight="20dp"
        android:paddingBottom="10dp"
        android:text="@string/fullscreen_hint_label"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:visibility="gone"
        android:focusable="true"
        android:translationZ="45dp"
        android:contentDescription="@string/fullscreen_hint_label" />

    <ImageView
        android:id="@+id/virtualCursor"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/cursor_arrow"
        android:translationZ="50dp"
        android:layout_gravity="top|start"
        android:contentDescription="Virtual Cursor" />
</FrameLayout>
